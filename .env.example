# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
MOD_ROLE_ID=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/giveaway_bot

# Code generation defaults
DEFAULT_CODE_EXPIRY_HOURS=24

# Kick webhooks
# Paste the PEM-format public key from https://docs.kick.com/apis/public-key
# (fetched once manually, not at runtime -- see bot/kick/signature.py)
KICK_WEBHOOK_PUBLIC_KEY=

# Set by Railway automatically -- do not set manually in production
PORT=8080
